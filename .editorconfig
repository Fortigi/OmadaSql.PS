# EditorConfig: http://EditorConfig.org
root = true

[*]
indent_style = space
insert_final_newline = true
charset = utf-8

[*.{ps1,psm1,psd1}]
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,ps1xml,nuspec}]
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
